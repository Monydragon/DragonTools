<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand palette (static) -->
    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="White">#FFFFFFFF</Color>
    <Color x:Key="Black">#FF000000</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1F1F1F</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- BRUSHES (stay DynamicResource so they live-update) -->
    <SolidColorBrush x:Key="AppBackgroundBrush"     Color="{DynamicResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush"    Color="{DynamicResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryBrush"           Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="AccentBrush"            Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="DangerBrush"            Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="WarningBrush"           Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="InfoBrush"              Color="{DynamicResource InfoColor}" />
    <!-- Use AppThemeBinding to guarantee a concrete Color at runtime for Stroke -->
    <SolidColorBrush x:Key="BorderBrush"            Color="{AppThemeBinding Light=#E2E8F0, Dark=#2A2A2A}" />
    <SolidColorBrush x:Key="DividerBrush"           Color="{DynamicResource DividerColor}" />
    <SolidColorBrush x:Key="SecondaryBrush"         Color="{DynamicResource SecondaryColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush"       Color="{DynamicResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush"     Color="{DynamicResource TextSecondary}" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush"     Color="{DynamicResource TextOnPrimary}" />
    <SolidColorBrush x:Key="EntryBackgroundBrush"   Color="{DynamicResource EntryBackgroundColor}" />
    <SolidColorBrush x:Key="PickerBackgroundBrush"  Color="{DynamicResource PickerBackgroundColor}" />
    <SolidColorBrush x:Key="SearchBarBackgroundBrush" Color="{DynamicResource SearchBarBackgroundColor}" />

</ResourceDictionary>
