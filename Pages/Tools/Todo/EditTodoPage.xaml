<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DragonTools.Pages.Tools.Todo.EditTodoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:todo="clr-namespace:DragonTools.Pages.Tools.Todo"
    Title="Edit Task"
    x:DataType="todo:EditTodoVm">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <!-- Title -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Task Title" FontSize="16" FontAttributes="Bold" />
                <Entry Placeholder="Enter title" Text="{Binding Title, Mode=TwoWay}" />
            </VerticalStackLayout>

            <!-- Notes -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Notes" FontSize="16" FontAttributes="Bold" />
                <Editor Placeholder="Enter notes" AutoSize="TextChanges" MinimumHeightRequest="100" Text="{Binding Notes, Mode=TwoWay}" />
            </VerticalStackLayout>

            <!-- Difficulty / Priority -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <Label Text="Difficulty" FontSize="16" FontAttributes="Bold" />
                    <Picker ItemsSource="{Binding DifficultyOptions}" SelectedItem="{Binding Difficulty, Mode=TwoWay}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label Text="Priority" FontSize="16" FontAttributes="Bold" />
                    <Picker ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding Priority, Mode=TwoWay}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Due date/time -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Due Date" FontSize="16" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Switch IsToggled="{Binding HasDue, Mode=TwoWay}" />
                    <Label Text="Enable" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8" IsVisible="{Binding HasDue}">
                    <DatePicker Date="{Binding DueDate, Mode=TwoWay}" />
                    <TimePicker Time="{Binding DueTime, Mode=TwoWay}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Tags -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Tags" FontSize="16" FontAttributes="Bold" />
                <Entry Placeholder="Comma separated (e.g., work, urgent, home)" Text="{Binding TagsText, Mode=TwoWay}" />
            </VerticalStackLayout>

            <!-- Checklist -->
            <Label Text="Checklist" FontSize="16" FontAttributes="Bold" />
            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2A2A2A}" Background="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}" StrokeShape="RoundRectangle 14" Padding="14" Margin="0,8">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="＋" Clicked="AddChecklist_Clicked" />
                        <Entry x:Name="ChecklistInput" Grid.Column="1" Placeholder="New checklist entry" />
                    </Grid>
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Checklist}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsDone, Mode=TwoWay}" />
                                    <Label Grid.Column="1" Text="{Binding Text}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                <Setter Property="TextColor" Value="Gray" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Button Grid.Column="2" Text="✕" Clicked="RemoveChecklist_Clicked" CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Reminders -->
            <Label Text="Reminders" FontSize="16" FontAttributes="Bold" />
            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2A2A2A}" Background="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}" StrokeShape="RoundRectangle 14" Padding="14" Margin="0,8">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="＋" Clicked="AddReminder_Clicked" />
                        <Entry x:Name="ReminderInput" Grid.Column="1" Placeholder="Reminder title (optional)" />
                    </Grid>
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Reminders}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Title}" />
                                    <Label Grid.Column="1" Text="{Binding When, StringFormat='at {0:MMM d h:mm tt}'}" />
                                    <Button Grid.Column="2" Text="✕" Clicked="RemoveReminder_Clicked" CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <HorizontalStackLayout Spacing="12" HorizontalOptions="End">
                <Button Text="Cancel" Clicked="Cancel_Clicked" />
                <Button Text="Save" Clicked="Save_Clicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
