<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DragonTools.Pages.Tools.Todo.TodoPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:todo="clr-namespace:DragonTools.Pages.Tools.Todo"
    xmlns:models="clr-namespace:DragonTools.Models"
    xmlns:conv="clr-namespace:DragonTools.Converters"
    Title="TODO"
    x:DataType="todo:TodoVm">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:DepthToThicknessConverter x:Key="DepthIndentConverter" />
            <conv:NullToBoolConverter x:Key="NullToBool" />
            <conv:IntGreaterThanZeroConverter x:Key="IntGT0" />
            <conv:DueOverdueConverter x:Key="DueOverdue" />
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light=#E5E7EB, Dark=#2D2D2D}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#181818}" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Margin" Value="16,8" />
            </Style>
            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F1F5F9, Dark=#222}" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1E293B, Dark=#F3F4F6}" />
                <Setter Property="BorderWidth" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="8" Padding="0,8,0,24">

            <!-- Actions -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Button Grid.Row="0" Grid.Column="0" Text="Add Task" Clicked="AddTask_Clicked" />
                        <Picker Grid.Row="0" Grid.Column="1"
                                Title="Sort"
                                ItemsSource="{Binding SortOptions}"
                                SelectedItem="{Binding SortBy, Mode=TwoWay}" />
                        <StackLayout Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalOptions="Center">
                            <Label Text="Asc" />
                            <Switch IsToggled="{Binding SortAscending, Mode=TwoWay}" />
                        </StackLayout>
                        <SearchBar Grid.Row="1" Grid.ColumnSpan="3" Placeholder="Search title, notes, or tags" Text="{Binding Search, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <CheckBox IsChecked="{Binding HideCompleted, Mode=TwoWay}" />
                            <Label Text="Hide Completed" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                            <Label Text="Group:" VerticalOptions="Center" />
                            <Picker Grid.Column="1" Title="Group By"
                                    ItemsSource="{Binding GroupOptions}"
                                    SelectedItem="{Binding GroupBy, Mode=TwoWay}" />
                        </Grid>
                    </Grid>

                    <!-- Tag filter chips -->
                    <ScrollView Orientation="Horizontal">
                        <HorizontalStackLayout Spacing="6">
                            <Button Text="All"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding SelectTagCommand}"
                                    CommandParameter="{x:Null}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedTag}" Value="">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E5E7EB, Dark=#333}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding AvailableTags}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Button Text="{Binding .}"
                                                Style="{StaticResource IconButton}"
                                                Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.SelectTagCommand}"
                                                CommandParameter="{Binding .}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button"
                                                            Binding="{Binding Source={x:Reference RootPage}, Path=BindingContext.SelectedTag}"
                                                            Value="{Binding .}">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E5E7EB, Dark=#333}" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>

            <!-- Task List (grouped) -->
            <Border Style="{StaticResource Card}">
                <CollectionView ItemsSource="{Binding GroupedItems}" SelectionMode="None" IsGrouped="True">
                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#111}" Padding="8,6" StrokeThickness="0">
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="24" Spacing="8" HorizontalOptions="Center">
                            <Label Text="No tasks yet" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TodoItem">
                            <SwipeView Margin="{Binding Depth, Converter={StaticResource DepthIndentConverter}}">
                                <SwipeView.LeftItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItem Text="Toggle Complete"
                                                   Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ToggleCompleteCommand}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.LeftItems>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItem Text="Delete"
                                                   BackgroundColor="#EF4444"
                                                   Invoked="ConfirmDelete_SwipeInvoked" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="8" ColumnSpacing="12">
                                    <!-- Complete -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" CheckedChanged="Complete_CheckedChanged" />

                                    <!-- Main content -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <!-- Expand/Collapse only if has subtasks -->
                                            <Button Text="▸" Style="{StaticResource IconButton}"
                                                    IsVisible="{Binding SubTasks.Count, Converter={StaticResource IntGT0}}"
                                                    Clicked="ToggleExpand_Clicked">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Text" Value="▾" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="EditTask_Tapped" />
                                                </Label.GestureRecognizers>
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        <Setter Property="TextColor" Value="Gray" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </HorizontalStackLayout>

                                        <Label Text="{Binding Note}" FontSize="13" TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />

                                        <!-- Meta chips: difficulty, priority, due -->
                                        <HorizontalStackLayout Spacing="8">
                                            <Border Style="{StaticResource Pill}">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Difficulty}" Value="VeryEasy">
                                                        <Setter Property="BackgroundColor" Value="#DCFCE7" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Difficulty}" Value="Easy">
                                                        <Setter Property="BackgroundColor" Value="#E0F2FE" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Difficulty}" Value="Medium">
                                                        <Setter Property="BackgroundColor" Value="#EDE9FE" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Difficulty}" Value="Hard">
                                                        <Setter Property="BackgroundColor" Value="#FEF3C7" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Difficulty}" Value="VeryHard">
                                                        <Setter Property="BackgroundColor" Value="#FEE2E2" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding Difficulty}" FontSize="12" />
                                            </Border>
                                            <Border Style="{StaticResource Pill}">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Priority}" Value="High">
                                                        <Setter Property="BackgroundColor" Value="#FEE2E2" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Priority}" Value="Medium">
                                                        <Setter Property="BackgroundColor" Value="#FEF3C7" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Priority}" Value="Low">
                                                        <Setter Property="BackgroundColor" Value="#DCFCE7" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding Priority}" FontSize="12" />
                                            </Border>
                                            <Border Style="{StaticResource Pill}" IsVisible="{Binding Due, Converter={StaticResource NullToBool}}">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Due, Converter={StaticResource DueOverdue}}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="#FEE2E2" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding Due, StringFormat='Due {0:MMM d h:mm tt}'}" FontSize="12" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <!-- Tags as chips -->
                                        <HorizontalStackLayout Spacing="6"
                                                              BindableLayout.ItemsSource="{Binding Tags}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Pill}"><Label Text="{Binding .}" FontSize="12" /></Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Actions (compact icons) -->
                                    <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                        <Button Text="✏️"
                                                Style="{StaticResource IconButton}"
                                                Clicked="EditTask_Clicked"
                                                ToolTipProperties.Text="Edit" />
                                        <Button Text="➕"
                                                Style="{StaticResource IconButton}"
                                                IsVisible="{Binding CanAddSubtask}"
                                                Clicked="AddSubtask_Clicked"
                                                ToolTipProperties.Text="Add Subtask" />
                                        <Button Text="🗑️"
                                                Style="{StaticResource IconButton}"
                                                Clicked="ConfirmDelete_Clicked"
                                                ToolTipProperties.Text="Delete" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
