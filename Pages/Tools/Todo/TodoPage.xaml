<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DragonTools.Pages.Tools.Todo.TodoPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:todo="clr-namespace:DragonTools.Pages.Tools.Todo"
    xmlns:conv="clr-namespace:DragonTools.Converters"
    xmlns:models="clr-namespace:DragonTools.Models"
    Title="TODO"
    x:DataType="todo:TodoVm">

    <!-- Bind the ViewModel directly in XAML -->
    <ContentPage.BindingContext>
        <todo:TodoVm />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:NullToBoolConverter x:Key="NullToBool" />
            <conv:IntGreaterThanZeroConverter x:Key="IntGt0" />
            <!-- ...existing styles... -->
            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F1F5F9, Dark=#222222}" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="12" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1E293B, Dark=#F3F4F6}" />
                <Setter Property="BorderWidth" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Top bar: Add + Search + basic filters -->
        <Grid Padding="12,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button Text="Add" Clicked="AddTask_Clicked" />
            <SearchBar Grid.Column="1" Placeholder="Search" Text="{Binding Search, Mode=TwoWay}" />
            <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="End" VerticalOptions="Center">
                <CheckBox IsChecked="{Binding HideCompleted, Mode=TwoWay}" />
                <VerticalStackLayout Spacing="0" Padding="0">
                    <Label FontSize="10" Text="Hide" HorizontalTextAlignment="Center" />
                    <Label FontSize="10" Text="Done" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding DisplayItems}" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="No tasks yet" FontAttributes="Bold" />
                    <Button Text="Create your first task" Clicked="AddTask_Clicked" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <Border Margin="12,6" Padding="12" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C1C}" Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2A2A2A}" StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" CheckedChanged="Complete_CheckedChanged" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                <Setter Property="TextColor" Value="Gray" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="EditTask_Tapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Note}" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" LineBreakMode="TailTruncation">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="TextColor" Value="Gray" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <HorizontalStackLayout Spacing="6">
                                    <Border Style="{StaticResource Pill}"><Label Text="{Binding Priority}" FontSize="11" /></Border>
                                    <Border Style="{StaticResource Pill}"><Label Text="{Binding Difficulty}" FontSize="11" /></Border>
                                    <Border Style="{StaticResource Pill}" IsVisible="{Binding Due, Converter={StaticResource NullToBool}}">
                                        <Label Text="{Binding Due, StringFormat='Due {0:MMM d}'}" FontSize="11" />
                                    </Border>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Tags}" IsVisible="{Binding Tags.Count, Converter={StaticResource IntGt0}}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Pill}"><Label Text="{Binding .}" FontSize="10" /></Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="End" VerticalOptions="Start">
                                <Button Text="✎" Style="{StaticResource IconButton}" Clicked="EditTask_Clicked" />
                                <Button Text="＋" Style="{StaticResource IconButton}" IsVisible="{Binding CanAddSubtask}" Clicked="AddSubtask_Clicked" />
                                <Button Text="✕" Style="{StaticResource IconButton}" Clicked="ConfirmDelete_Clicked" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            x:Name="FabAddTodo"
            Text="＋"
            WidthRequest="56"
            HeightRequest="56"
            CornerRadius="28"
            FontSize="32"
            BackgroundColor="#2563EB"
            TextColor="White"
            VerticalOptions="End"
            HorizontalOptions="End"
            Margin="24"
            Clicked="AddTask_Clicked">
            <Button.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.4" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>
