<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DragonTools.Pages.Tools.Todo.TodoPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:todo="clr-namespace:DragonTools.Pages.Tools.Todo"
    xmlns:conv="clr-namespace:DragonTools.Converters"
    xmlns:models="clr-namespace:DragonTools.Models"
    Title="TODO"
    x:DataType="todo:TodoVm">

    <ContentPage.BindingContext>
        <todo:TodoVm />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:NullToBoolConverter x:Key="NullToBool" />
            <conv:IntGreaterThanZeroConverter x:Key="IntGt0" />
            <conv:DifficultyToColorConverter x:Key="DiffColor" />
            <conv:DifficultyToAbbrevConverter x:Key="DiffAbbrev" />
            <conv:DifficultyToNameConverter x:Key="DiffName" />
            <conv:PriorityToColorConverter x:Key="PrioColor" />
            <conv:PriorityToSymbolConverter x:Key="PrioSymbol" />
            <conv:TagOverflowConverter x:Key="TagOverflow" />
            <conv:DepthToIndentConverter x:Key="DepthIndent" />
            <!-- Reusable styles -->
            <Style TargetType="Button" x:Key="IconBtn">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="TextColor" Value="#E5E7EB" />
                <Setter Property="WidthRequest" Value="42" />
                <Setter Property="HeightRequest" Value="42" />
            </Style>
            <Style TargetType="Button" x:Key="HeaderAddButton">
                <Setter Property="BackgroundColor" Value="#6366F1" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="32" />
                <Setter Property="WidthRequest" Value="56" />
                <Setter Property="HeightRequest" Value="56" />
                <Setter Property="CornerRadius" Value="28" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style TargetType="Label" x:Key="MetaLabel">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="#9CA3AF" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Header: Search + Add -->
        <Grid Padding="12,8,12,4" ColumnDefinitions="*,Auto" RowDefinitions="Auto">
            <SearchBar Grid.Column="0" Placeholder="Search" Text="{Binding Search, Mode=TwoWay}" Margin="0,0,12,0" />
            <Button Grid.Column="1" Text="＋" Style="{StaticResource HeaderAddButton}" Clicked="AddTask_Clicked" />
        </Grid>

        <!-- Task list -->
        <Grid Grid.Row="1">
            <CollectionView
                x:Name="TasksList"
                ItemsSource="{Binding DisplayItems}"
                SelectionMode="None"
                VerticalOptions="Fill"
                Margin="4,0,4,0">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24,40" Spacing="8" HorizontalOptions="Center">
                        <Label Text="No tasks yet" FontAttributes="Bold" />
                        <Label Text="Tap + to create one" FontSize="12" TextColor="#9CA3AF" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TodoItem">
                        <Border
                            Padding="0"
                            Margin="{Binding Depth, Converter={StaticResource DepthIndent}}"
                            BackgroundColor="#1C1C20"
                            StrokeThickness="0">
                            <Border.Triggers>
                                <!-- Order: overdue, due soon, completed (completed wins) -->
                                <DataTrigger TargetType="Border" Binding="{Binding IsOverdue}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#5B0F0F" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsDueSoon}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#5C3B00" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#065F46" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid Padding="10,8" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                                <!-- Checkbox -->
                                <CheckBox Grid.RowSpan="2" VerticalOptions="Start" Margin="0,0,12,0" IsChecked="{Binding IsCompleted}" CheckedChanged="Complete_CheckedChanged" />

                                <!-- Title / meta (tap expands) -->
                                <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                            <HorizontalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="ExpandCollapse_Clicked" />
                                            </HorizontalStackLayout.GestureRecognizers>
                                            <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="1">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        <Setter Property="TextColor" Value="#6B7280" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsOverdue}" Value="True">
                                                        <Setter Property="TextColor" Value="#F87171" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsDueSoon}" Value="True">
                                                        <Setter Property="TextColor" Value="#FBBF24" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <!-- Difficulty dot -->
                                            <Border WidthRequest="12" HeightRequest="12" StrokeThickness="0" VerticalOptions="Center" BackgroundColor="{Binding Difficulty, Converter={StaticResource DiffColor}}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6" />
                                                </Border.StrokeShape>
                                            </Border>
                                            <Label Text="{Binding Difficulty, Converter={StaticResource DiffName}}" FontSize="11" TextColor="#E5E7EB" />
                                            <!-- Priority -->
                                            <Label Text="{Binding Priority, Converter={StaticResource PrioSymbol}}" FontSize="16" TextColor="{Binding Priority, Converter={StaticResource PrioColor}}" />
                                            <!-- Due pill -->
                                            <Border IsVisible="{Binding DueShort, Converter={StaticResource NullToBool}}" Padding="6,2" BackgroundColor="#1F2937" StrokeThickness="0" Margin="4,0,0,0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                <Label Text="{Binding DueShort}" FontSize="11" TextColor="#E5E7EB" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <!-- Edit button -->
                                        <Button Grid.Column="1" Text="✎" Style="{StaticResource IconBtn}" Clicked="EditTask_Clicked" CommandParameter="{Binding .}" />
                                        <!-- Delete button -->
                                        <Button Grid.Column="2" Text="🗑" Style="{StaticResource IconBtn}" TextColor="#EF4444" Clicked="DeleteTask_Clicked" CommandParameter="{Binding .}" />
                                        <!-- Expand arrow -->
                                        <Label Grid.Column="3" Text="▶" FontSize="14" VerticalTextAlignment="Center" HorizontalTextAlignment="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Text" Value="▾" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="ExpandCollapse_Clicked" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                    <!-- Tags row (collapsed single line) -->
                                    <HorizontalStackLayout Spacing="4" Margin="0,2,0,0" BindableLayout.ItemsSource="{Binding LimitedTags}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border StrokeThickness="0" BackgroundColor="#2563EB" Padding="8,2" Margin="0,0,6,0">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                    <Label Text="{Binding .}" FontSize="11" TextColor="White" LineBreakMode="TailTruncation" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                    <Border StrokeThickness="0" BackgroundColor="#374151" Padding="8,2" Margin="0,0,6,0" IsVisible="{Binding HasTagsOverflow}">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                        <Label Text="{Binding TagsOverflow, StringFormat='+{0}'}" FontSize="11" TextColor="#E5E7EB" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Right info bubble -->
                                <Border Grid.Column="2" BackgroundColor="#312E81" Padding="6,2" StrokeThickness="0" IsVisible="{Binding RightInfo, Converter={StaticResource NullToBool}}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Label Text="{Binding RightInfo}" FontSize="11" TextColor="#C7D2FE" />
                                </Border>

                                <!-- Spacer for layout alignment -->
                                <BoxView Grid.Column="3" WidthRequest="4" />

                                <!-- Expanded content -->
                                <Grid Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3" Padding="0,8,0,4" IsVisible="{Binding IsExpanded}">
                                    <VerticalStackLayout Spacing="8">
                                        <ScrollView MaximumHeightRequest="140" IsVisible="{Binding Note, Converter={StaticResource NullToBool}}" VerticalScrollBarVisibility="Always">
                                            <Label Text="{Binding Note}" FontSize="12" TextColor="#D4D4D8" LineBreakMode="WordWrap" />
                                        </ScrollView>
                                        <!-- Full tags (when expanded) -->
                                        <HorizontalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Tags}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border StrokeThickness="0" BackgroundColor="#25262B" Padding="6,2" Margin="0,0,6,6">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                        <Label Text="{Binding .}" FontSize="11" TextColor="#38BDF8" LineBreakMode="TailTruncation" />
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </HorizontalStackLayout>
                                        <!-- Add subtask link -->
                                        <Label Text="+ add subtask" FontSize="12" TextColor="#F43F5E" IsVisible="{Binding CanAddSubtask}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="AddSubtask_Clicked" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ExpandCollapse_Clicked" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Toast overlay kept as-is -->
            <Grid x:Name="ToastPanel" IsVisible="False" Opacity="0" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,40" Padding="0">
                <Border BackgroundColor="#2C2C30" StrokeThickness="0" Padding="16,10">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <HorizontalStackLayout Spacing="18" VerticalOptions="Center" HorizontalOptions="Center">
                        <Label x:Name="ToastMessage" Text="Action" TextColor="White" FontSize="13" LineBreakMode="TailTruncation" MaxLines="2" />
                        <Label Text="UNDO" TextColor="#60A5FA" FontSize="13" FontAttributes="Bold">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Undo_Tapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
