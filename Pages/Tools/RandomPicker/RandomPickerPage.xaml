<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DragonTools.Pages.Tools.RandomPicker.RandomPickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Random Picker">

    <!-- Page grid: top bar / entries (fills) / roll -->
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Top bar -->
            <RowDefinition Height="*"/>     <!-- Entries fills & scrolls internally -->
            <RowDefinition Height="Auto"/>  <!-- Roll -->
        </Grid.RowDefinitions>

        <!-- TOP BAR: list dropdown + actions -->
        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <Picker x:Name="SavedListPicker"
                        Grid.Column="0"
                        Title="Select a list"
                        ItemsSource="{Binding SavedListDisplay}"
                        SelectedIndexChanged="SavedList_SelectedIndexChanged" />

                <Button Grid.Column="1" Text="New"    Clicked="CreateList_Clicked" />
                <Button Grid.Column="2" Text="Save"   Clicked="Save_Clicked" />
                <Button Grid.Column="3" Text="Delete" Clicked="DeleteList_Clicked" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Grid.Column="0"
                       Text="{Binding TypeBadge}"
                       FontAttributes="Bold" />
                <Label Grid.Column="1"
                       Text="{Binding ListName}"
                       LineBreakMode="TailTruncation"
                       Opacity="0.7" />
            </Grid>
        </VerticalStackLayout>

        <!-- ENTRIES (fills available space; list scrolls) -->
        <toolkit:Expander Grid.Row="1" IsExpanded="True">
            <toolkit:Expander.Header>
                <Label Text="Entries" FontAttributes="Bold" FontSize="20" Padding="0,4"/>
            </toolkit:Expander.Header>

            <!-- Use a Grid so only the list scrolls -->
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Add row -->
                    <RowDefinition Height="Auto"/>  <!-- Search -->
                    <RowDefinition Height="*"/>     <!-- List (scrolls) -->
                </Grid.RowDefinitions>

                <!-- Add row ABOVE the list -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0"
                           Placeholder="Entry"
                           Text="{Binding NewItemEntry, Mode=TwoWay}" />
                    <Entry Grid.Column="1"
                           Placeholder="Weight"
                           Keyboard="Numeric"
                           IsVisible="{Binding IsWeightedMode}"
                           Text="{Binding NewItemWeight, Mode=TwoWay}"/>
                    <Button Grid.Column="2" Text="Add" Clicked="AddItem_Clicked"/>
                </Grid>

                <!-- Search stays pinned -->
                <SearchBar Grid.Row="1"
                           Placeholder="Search entries..."
                           Text="{Binding SearchText, Mode=TwoWay}"
                           TextChanged="OptionsSearch_TextChanged"/>

                <!-- Scrollable list fills remaining space -->
                <CollectionView Grid.Row="2"
                                ItemsSource="{Binding FilteredItems}"
                                SelectionMode="None"
                                VerticalOptions="FillAndExpand">
                    <CollectionView.EmptyView>
                        <Label Text="No entries" Padding="8" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" /> <!-- weight -->
                                    <ColumnDefinition Width="Auto" /> <!-- edit -->
                                    <ColumnDefinition Width="Auto" /> <!-- delete -->
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0"
                                       Text="{Binding Entry}"
                                       VerticalOptions="Center"/>

                                <Entry Grid.Column="1"
                                       HorizontalTextAlignment="Center"
                                       Keyboard="Numeric"
                                       Text="{Binding Weight, Mode=TwoWay}"
                                       Placeholder="W"
                                       IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsWeightedMode}" />

                                <Button Grid.Column="2" Text="Edit" Clicked="EditItem_Clicked"/>
                                <Button Grid.Column="3" Text="Delete" Clicked="DeleteItem_Clicked"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </toolkit:Expander>

        <!-- ROLL: button in header so it's higher up -->
        <toolkit:Expander Grid.Row="2" IsExpanded="True">
            <toolkit:Expander.Header>
                <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                    <Label Text="Roll" FontAttributes="Bold" FontSize="20"/>
                    <Button Grid.Column="1" Text="Roll 🎲" Clicked="Roll_Clicked"/>
                </Grid>
            </toolkit:Expander.Header>

            <Label Text="Tap Roll to pick a result." Opacity="0.7" />
        </toolkit:Expander>
    </Grid>
</ContentPage>
