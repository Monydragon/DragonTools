<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DragonTools.Pages.Tools.RandomPicker.RandomPickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Random Picker">
    
    <!-- Top-right gear button -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Settings"
                     IconImageSource="settings.png"
                     Priority="0"
                     Order="Primary"
                     Clicked="OpenSettings_Clicked" />
    </ContentPage.ToolbarItems>
    <ScrollView>
        
        <!-- Page grid: top bar / entries (fills) / roll -->
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Top bar -->
            <RowDefinition Height="*"/>     <!-- Entries fills & scrolls internally -->
            <RowDefinition Height="Auto"/>  <!-- Roll -->
        </Grid.RowDefinitions>

        
        <!-- TOP BAR: list dropdown (top) + actions (below) -->
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <!-- Dropdown on its own row -->
            <Picker x:Name="SavedListPicker"
                    Title="Select a list"
                    ItemsSource="{Binding SavedListDisplay}"
                    SelectedIndexChanged="SavedList_SelectedIndexChanged"
                    HorizontalOptions="FillAndExpand"
                    Margin="0,0,0,2" />

            <!-- Action buttons below the dropdown -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Text="New"    Clicked="CreateList_Clicked" BackgroundColor="DarkCyan" />
                <Button Grid.Column="1" Text="Save"   Clicked="Save_Clicked"  BackgroundColor="DarkCyan"/>
                <Button Grid.Column="2" Text="Delete" Clicked="DeleteList_Clicked" BackgroundColor="DarkCyan" />
                <Button Grid.Column="3" Text="Rename" Clicked="RenameList_Clicked"  BackgroundColor="DarkCyan"/>
                <Button Grid.Column="4" Text="Type"   Clicked="ChangeType_Clicked" BackgroundColor="DarkCyan"/>
            </Grid>

            <!-- Current list/type display -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Grid.Column="0"
                       Text="{Binding TypeBadge}"
                       FontAttributes="Bold" />
                <Label Grid.Column="1"
                       Text="{Binding ListName}"
                       LineBreakMode="TailTruncation"
                       Opacity="0.7" />
            </Grid>
        </VerticalStackLayout>
        
        
        <!-- ENTRIES (collapsible; list gets finite height and scrolls) -->
        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="*"/>     <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Header with chevron -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="0,4">
                <Label Text="Entries" FontAttributes="Bold" FontSize="20"/>
                <Button Grid.Column="1"
                        Text="{Binding EntriesChevron}"
                        Padding="8,2"
                        Clicked="ToggleEntries_Clicked" BackgroundColor="DarkCyan"/>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1" RowSpacing="10" IsVisible="{Binding EntriesExpanded}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Bulk Add -->
                    <RowDefinition Height="Auto"/>  <!-- Search -->
                    <RowDefinition Height="*"/>     <!-- List (scrolls) -->
                    <RowDefinition Height="Auto"/>  <!-- Pager -->
                </Grid.RowDefinitions>

                <!-- Bulk add (ALWAYS visible, Editor expands with text) -->
                <VerticalStackLayout Grid.Row="0" Spacing="8">
                    <Label Text="Bulk Add (comma / newline; weights: :n, *n, x n, (n), [n])"
                           FontAttributes="Bold" />
                    <Editor x:Name="BulkEditor"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="60"
                            MaximumHeightRequest="220"
                            Placeholder="e.g. Taco, Burrito[2], Pasta (15)&#10;Burger*4, Sushi:3"
                            Text="{Binding BulkText, Mode=TwoWay}" />
                    <Label Text="Tip: weights are used only when the list type is Weighted."
                           FontSize="12" Opacity="0.6"/>

                    <!-- Right-aligned Add Items button -->
                    <Grid ColumnDefinitions="*">
                        <Button Grid.Column="0"
                                Text="Add Items"
                                HorizontalOptions="End"
                                Clicked="AddBulkItems_Clicked" BackgroundColor="DarkCyan"/>
                    </Grid>
                </VerticalStackLayout>

                <!-- Search stays pinned -->
                <SearchBar Grid.Row="1"
                           Placeholder="Search entries..."
                           Text="{Binding SearchText, Mode=TwoWay}"
                           TextChanged="OptionsSearch_TextChanged"/>

                <!-- Scrollable list -->
                <CollectionView Grid.Row="2"
                                ItemsSource="{Binding PagedItems}"
                                SelectionMode="None"
                                VerticalOptions="FillAndExpand">
                    <CollectionView.EmptyView>
                        <Label Text="No entries" Padding="8" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" /> <!-- weight -->
                                    <ColumnDefinition Width="Auto" /> <!-- edit -->
                                    <ColumnDefinition Width="Auto" /> <!-- delete -->
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0"
                                       Text="{Binding Entry}"
                                       VerticalOptions="Center"/>

                                <Entry Grid.Column="1"
                                       HorizontalTextAlignment="Center"
                                       Keyboard="Numeric"
                                       Text="{Binding Weight, Mode=TwoWay}"
                                       Placeholder="W"
                                       IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsWeightedMode}" />

                                <Button Grid.Column="2" Text="Edit" Clicked="EditItem_Clicked"/>
                                <Button Grid.Column="3" Text="Delete" Clicked="DeleteItem_Clicked"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Pager (always visible under the list) -->
                <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="Page size" VerticalOptions="Center" />
                    <!-- You set this to WidthRequest=20; preserving that -->
                    <Picker Grid.Column="1" WidthRequest="20"
                            ItemsSource="{Binding PageSizeOptions}"
                            SelectedItem="{Binding PageSize, Mode=TwoWay}" />
                    <Label Grid.Column="2" Text="{Binding PageLabel}" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                    <Button Grid.Column="3" Text="Prev" Clicked="PrevPage_Clicked" BackgroundColor="DarkCyan"/>
                    <Button Grid.Column="4" Text="Next" Clicked="NextPage_Clicked" BackgroundColor="DarkCyan"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ROLL -->
        <toolkit:Expander Grid.Row="2" IsExpanded="True">
            <toolkit:Expander.Header>
                <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                    <Label Text="Roll" FontAttributes="Bold" FontSize="20"/>
                    <Button Grid.Column="1" Text="Roll 🎲" Clicked="Roll_Clicked" BackgroundColor="DarkCyan"/>
                </Grid>
            </toolkit:Expander.Header>
            <Label Text="Tap Roll to pick a result." Opacity="0.7" />
        </toolkit:Expander>
    </Grid>
    </ScrollView>
</ContentPage>
