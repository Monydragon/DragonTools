<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DragonTools.Pages.Tools.RandomPicker.RandomPickerPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:randomPicker="clr-namespace:DragonTools.Pages.Tools.RandomPicker"
    Title="Random Picker" x:DataType="randomPicker:RandomPickerVm"
    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#121212}">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Modern Color Scheme (now all DynamicResource) -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource CardBackgroundColor}" />
                <Setter Property="Stroke" Value="{DynamicResource BorderBrush}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            </Style>
            <Style x:Key="TabButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource SecondaryColor}" />
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BorderWidth" Value="0" />
            </Style>
            <Style x:Key="ActiveTabButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BorderWidth" Value="0" />
            </Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource SecondaryColor}" />
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource AccentColor}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="DangerButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource DangerColor}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Margin" Value="0,8,0,4" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <!-- Toolbar -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Settings" IconImageSource="settings.png" Clicked="OpenSettings_Clicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">
        <!-- Tab Bar -->
        <Border Grid.Row="0" 
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#181818}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1"
                Padding="16,8">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button x:Name="ManageTab" 
                        Grid.Column="0" 
                        Text="📋 Manage" 
                        Style="{DynamicResource ActiveTabButtonStyle}"
                        Clicked="ManageTab_Clicked" />
                <Button x:Name="EntriesTab" 
                        Grid.Column="1" 
                        Text="📝 Entries" 
                        Style="{DynamicResource TabButtonStyle}"
                        IsEnabled="{Binding HasActiveList}"
                        Clicked="EntriesTab_Clicked" />
                <Button x:Name="RollTab" 
                        Grid.Column="2" 
                        Text="🎲 Roll" 
                        Style="{DynamicResource TabButtonStyle}"
                        IsEnabled="{Binding CanRoll}"
                        Clicked="RollTab_Clicked" />
            </Grid>
        </Border>
        
        <!-- Tab Content -->
        <Grid Grid.Row="1">
            
            <!-- MANAGE CONTENT -->
            <ScrollView x:Name="ManageContent" IsVisible="True" Padding="16">
                <VerticalStackLayout Spacing="16">
                    <!-- Actions first: New List on top -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnDefinitions="*" RowDefinitions="Auto" >
                            <Button Grid.Row="0" Grid.Column="0" Text="🆕 New List" 
                                    Clicked="CreateList_Clicked" Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </Border>

                    <!-- Select List AFTER actions -->
                    <Border Style="{StaticResource CardStyle}"
                            IsVisible="{Binding ShowSelectListPanel}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="📁 Select List" Style="{StaticResource SectionHeaderStyle}" />
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Picker x:Name="SavedListPicker"
                                        Grid.Column="0"
                                        Title="Choose a list"
                                        ItemsSource="{Binding SavedListDisplay}"
                                        SelectedItem="{Binding SelectedList, Mode=TwoWay}"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                                        TextColor="{AppThemeBinding Light=#1E293B, Dark=#F3F4F6}" />
                                <Button Grid.Column="1" Text="✏️" ToolTipProperties.Text="Edit" Clicked="EditList_Clicked" Style="{StaticResource SecondaryButtonStyle}" Padding="10,8" />
                                <Button Grid.Column="2" Text="🗑️" ToolTipProperties.Text="Delete" Clicked="DeleteList_Clicked" Style="{StaticResource DangerButtonStyle}" Padding="10,8" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    
                    <!-- Current List Info Card - fixed structure -->
                    <Border Style="{StaticResource CardStyle}"
                            IsVisible="{Binding ShowCurrentInfoPanel}"
                            ToolTipProperties.Text="Open entries"
                            SemanticProperties.Hint="Tap to open entries"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow x:Name="InfoShadow" Radius="12" Opacity="0.15" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="NavigateToEntriesTab" />
                        </Border.GestureRecognizers>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter TargetName="InfoShadow" Property="Shadow.Opacity" Value="0.15" />
                                        <Setter Property="Scale" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter TargetName="InfoShadow" Property="Shadow.Opacity" Value="0.25" />
                                        <Setter Property="Scale" Value="1.005" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter TargetName="InfoShadow" Property="Shadow.Opacity" Value="0.12" />
                                        <Setter Property="Scale" Value="0.99" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*" RowSpacing="10">
                            <!-- Header with action cue -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="📋 Current List"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       VerticalOptions="Center" />
                                <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalOptions="Center">
                                    <Label Text="Open entries" FontSize="12" TextColor="{AppThemeBinding Light=#2563EB, Dark=#3B82F6}" />
                                    <Label Text="›" FontSize="20" TextColor="{AppThemeBinding Light=#2563EB, Dark=#3B82F6}" />
                                </StackLayout>
                            </Grid>

                            <!-- Centered list name with type pill -->
                            <StackLayout Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                                <Label Text="{Binding ListName}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Border BackgroundColor="{AppThemeBinding Light=#2563EB, Dark=#3B82F6}"
                                        Stroke="{AppThemeBinding Light=#2563EB, Dark=#3B82F6}"
                                        StrokeThickness="1"
                                        Padding="10,4">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding TypeBadge}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                </Border>
                            </StackLayout>

                            <!-- Compact stats chips -->
                            <StackLayout Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                                <Border Padding="10,4" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EEFDF5, Dark=#093227}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <StackLayout Orientation="Horizontal" Spacing="6">
                                        <Label Text="Items:" FontSize="12" TextColor="{AppThemeBinding Light=#065F46, Dark=#6EE7B7}" />
                                        <Label x:Name="ManageItemsCount" Text="{Binding Items.Count}" FontAttributes="Bold" FontSize="12" TextColor="{AppThemeBinding Light=#065F46, Dark=#6EE7B7}" />
                                    </StackLayout>
                                </Border>
                                <Border Padding="10,4" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EAF2FF, Dark=#0A1E3A}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Label x:Name="ListStatus" Text="{Binding ListStatusText}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1D4ED8, Dark=#93C5FD}" />
                                </Border>
                            </StackLayout>
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
            
            <!-- ENTRIES CONTENT -->
            <ScrollView x:Name="EntriesContent" IsVisible="False" Padding="16">
                <VerticalStackLayout Spacing="16">
                    <!-- Current List header: center the name -->
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Fill">
                            <Label Text="📝 Current List" Style="{StaticResource SectionHeaderStyle}" HorizontalOptions="Center" />
                            <Label Text="{Binding ListNameWithType}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Bulk Add Section - Collapsible -->
                    <toolkit:Expander x:Name="BulkAddExpander" IsExpanded="True">
                        <toolkit:Expander.Header>
                            <StackLayout Orientation="Horizontal" Spacing="12" VerticalOptions="Center">
                                <Label Text="📦" FontSize="18" VerticalOptions="Center" />
                                <Label Text="Bulk Add Items" Style="{StaticResource SectionHeaderStyle}" VerticalOptions="Center" />
                                <Label Text="Tap to collapse" FontSize="12" TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                            </StackLayout>
                        </toolkit:Expander.Header>
                        <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Add multiple items at once" FontSize="14" TextColor="{StaticResource Secondary}" />
                                <Editor x:Name="BulkEditor"
                                        Placeholder="Taco, Burrito[2], Pasta[15]&#10;Burger[4], Sushi[3]"
                                        Text="{Binding BulkText, Mode=TwoWay}"
                                        AutoSize="TextChanges"
                                        MinimumHeightRequest="80"
                                        MaximumHeightRequest="150"
                                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1A1A1A}"
                                        TextColor="{AppThemeBinding Light=#1E293B, Dark=#F3F4F6}" />
                                <Label Text="Format: Item or Item[weight] (e.g., Pizza[3])" FontSize="11" TextColor="{StaticResource Secondary}" />
                                <Button Text="➕ Add Items" Clicked="AddBulkItems_Clicked" Style="{StaticResource AccentButtonStyle}" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Border>
                    </toolkit:Expander>

                    <!-- Search Section -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="🔍 Search Entries" Style="{StaticResource SectionHeaderStyle}" />
                            <SearchBar Placeholder="Type to filter entries..."
                                       Text="{Binding SearchText, Mode=TwoWay}"
                                       TextChanged="OptionsSearch_TextChanged"
                                       BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#222222}"
                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#F3F4F6}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Entries List -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Text="📋 Entry List" Style="{StaticResource SectionHeaderStyle}" />
                            <CollectionView Grid.Row="1"
                                            ItemsSource="{Binding PagedItems}"
                                            SelectionMode="None"
                                            BackgroundColor="Transparent">
                                <CollectionView.EmptyView>
                                    <VerticalStackLayout Padding="40" Spacing="8">
                                        <Label Text="📝" FontSize="48" HorizontalOptions="Center" Opacity="0.3" />
                                        <Label Text="No entries yet" FontSize="16" TextColor="{StaticResource Secondary}" HorizontalOptions="Center" />
                                        <Label Text="Add some items to get started!" FontSize="14" TextColor="{StaticResource Secondary}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="{x:Null}">
                                        <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1A1A1A}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" Padding="12" Margin="0,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <Label Grid.Column="0" Text="{Binding Entry}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1E293B, Dark=#F3F4F6}" />
                                                <Label Grid.Column="1"
                                                       IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsWeightedMode}"
                                                       Text="{Binding Weight, StringFormat='[Weight: {0}]'}"
                                                       FontSize="14" FontAttributes="Italic" VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light=#2563EB, Dark=#3B82F6}" />
                                                <StackLayout Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalOptions="Center">
                                                    <Button Text="✏️" Clicked="EditItem_Clicked" Style="{StaticResource SecondaryButtonStyle}" />
                                                    <Button Text="🗑️" Clicked="DeleteItem_Clicked" Style="{StaticResource DangerButtonStyle}" />
                                                </StackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Border>

                    <!-- Pagination -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="Show:" VerticalOptions="Center" FontSize="14" />
                            <Picker Grid.Column="1" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize, Mode=TwoWay}" WidthRequest="70" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" TextColor="{AppThemeBinding Light=#1E293B, Dark=#F3F4F6}" />
                            <Label Grid.Column="2" Text="{Binding PageLabel}" HorizontalTextAlignment="Center" VerticalOptions="Center" FontSize="14" />
                            <Button Grid.Column="3" Text="⬅️" Clicked="PrevPage_Clicked" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" />
                            <Button Grid.Column="4" Text="➡️" Clicked="NextPage_Clicked" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
            
            <!-- ROLL CONTENT -->
            <ScrollView x:Name="RollContent" 
                        IsVisible="False" 
                        Padding="16">
                <VerticalStackLayout Spacing="24">
                    
                    <!-- Current List header: center the name -->
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Fill">
                            <Label Text="🎲 Current List" Style="{StaticResource SectionHeaderStyle}" HorizontalOptions="Center" />
                            <Label Text="{Binding ListNameWithType}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    
                    <!-- Roll Action Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                            <Label Text="🎯 Random Picker" 
                                   Style="{StaticResource SectionHeaderStyle}"
                                   HorizontalOptions="Center" />
                            
                            <Label Text="Ready to pick a random choice?" 
                                   FontSize="16" 
                                   TextColor="{StaticResource Secondary}"
                                   HorizontalOptions="Center" />
                            
                            <!-- Large Roll Button -->
                            <Button Text="🎲 ROLL NOW" 
                                    Clicked="Roll_Clicked"
                                    BackgroundColor="{AppThemeBinding Light=#10B981, Dark=#34D399}"
                                    TextColor="White"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    CornerRadius="50"
                                    Padding="40,20"
                                    WidthRequest="200"
                                    HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    
                    <!-- Last Result Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="🏆 Last Result" Style="{StaticResource SectionHeaderStyle}" />
                            
                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1A1A1A}" 
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1"
                                    Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label x:Name="LastResultLabel"
                                       Text="Click roll to see result..." 
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#F3F4F6}"
                                       HorizontalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                    
                    <!-- Quick Stats Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="📊 Quick Stats" Style="{StaticResource SectionHeaderStyle}" />
                            
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <Label Text="Total Items" 
                                           FontSize="12" 
                                           TextColor="{StaticResource Secondary}" />
                                    <Label x:Name="TotalItemsLabel"
                                           Text="0" 
                                           FontSize="20" 
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#2563EB, Dark=#3B82F6}" />
                                </VerticalStackLayout>
                                
                                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                    <Label Text="List Type" 
                                           FontSize="12" 
                                           TextColor="{StaticResource Secondary}" />
                                    <Label Text="{Binding TypeBadge}" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#10B981, Dark=#34D399}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    
                </VerticalStackLayout>
            </ScrollView>
            
        </Grid>
    </Grid>
</ContentPage>
