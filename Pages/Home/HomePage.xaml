<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DragonTools.Pages.Home.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dragon Tools">

    <ContentPage.Resources>
        <!-- Simple tile style -->
        <Style TargetType="Button" x:Key="TileButton">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalOptions" Value="Fill"/>
            <Setter Property="VerticalOptions" Value="Fill"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#f2f2f7, Dark=#232329}"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#111111, Dark=#f7f7f7}"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <!-- Grid of tiles; add rows/columns as you add tools -->
        <Grid Padding="16" ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tool Tile: Random Picker -->
            <Button Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource TileButton}"
                    Text="🎲 Random Picker"
                    Clicked="OpenRandomPicker_Clicked"/>

            <!-- Tool Tile: Symptom Tracker -->
            <Button Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource TileButton}"
                    Text="🩺 Symptom Tracker"
                    Clicked="OpenSymptomTracker_Clicked"/>

            <!-- (Future) Add more tiles here... -->
        </Grid>
    </ScrollView>
</ContentPage>